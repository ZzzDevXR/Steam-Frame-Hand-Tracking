+// Frame Hand Tracking: load `basename` (.pte) from the models folder through fhm_nn (ExecuTorch) and allocate
+// one input buffer per model input. Throws on any mismatch; the callers' try blocks report it.
+static void
+fhl_load_executorch(HandTracking *hgt, onnx_state *state, const char *basename,
+                    std::initializer_list<size_t> input_elements)
+{
+	std::filesystem::path path = hgt->models_folder;
+	path /= basename;
+	std::string error;
+	state->wraps.clear();
+	state->et = fhm_nn::load(path.string(), &error);
+	if (state->et == nullptr) {
+		throw std::runtime_error("ExecuTorch: " + error);
+	}
+	if (fhm_nn::num_inputs(state->et) != input_elements.size()) {
+		throw std::runtime_error("ExecuTorch: " + path.string() + " has an unexpected number of inputs");
+	}
+	size_t i = 0;
+	for (size_t n : input_elements) {
+		if (fhm_nn::input_elements(state->et, i++) != n) {
+			throw std::runtime_error("ExecuTorch: " + path.string() + " has an unexpected input size");
+		}
+		model_input_wrap input = {};
+		input.data = (float *)calloc(n, sizeof(float));
+		state->wraps.push_back(input);
+	}
+}
+
+// Frame Hand Tracking: the selected backend; an invalid FHL_NN_BACKEND fails model setup.
+static bool
+fhl_use_executorch()
+{
+	if (const char *error = fhm_nn::backend_error()) {
+		throw std::runtime_error(error);
+	}
+	return fhm_nn::use_executorch();
+}
+
+// Frame Hand Tracking: one forward through ExecuTorch; `outputs` point into the model until its next run.
+static void
+fhl_run_executorch(onnx_state *state, size_t num_outputs, const float **outputs, const size_t *output_elements)
+{
+	if (fhm_nn::num_outputs(state->et) != num_outputs) {
+		throw std::runtime_error("ExecuTorch: unexpected number of outputs");
+	}
+	for (size_t i = 0; i < num_outputs; i++) {
+		if (fhm_nn::output_elements(state->et, i) != output_elements[i]) {
+			throw std::runtime_error("ExecuTorch: unexpected output size");
+		}
+	}
+	std::vector<const float *> inputs;
+	for (const model_input_wrap &input : state->wraps) {
+		inputs.push_back(input.data);
+	}
+	std::string error;
+	if (!fhm_nn::run(state->et, inputs.data(), outputs, &error)) {
+		throw std::runtime_error("ExecuTorch: " + error);
+	}
+}
